{
  "id": "TSK-11",
  "name": "Tampa Scale of Kinesiophobia – 11",
  "abbreviation": "TSK-11",
  "version": "Woby et al. 2005",
  "category": "screening",
  "icfCode": "pf",
  "icfLabel": "Fear of Movement / Kinesiophobia",
  "type": "Screening",
  "description": "11-item self-report questionnaire measuring fear of movement and (re)injury. Derived from the original 17-item TSK by removing the 4 reverse-scored items plus 2 poorly loading items. Higher scores indicate greater kinesiophobia.",
  "instructions": "Below are a series of statements that may or may not describe your feelings. Please rate how strongly you agree or disagree with each statement by circling the number that best represents your feelings. There are no right or wrong answers. Please do not spend too long on each statement.",
  "copyright": "Free for non-commercial clinical/research use",
  "shirleySays": "ICC 0.80–0.87. MDC: ~5 pts. MCID: ~5 pts. Cronbach α 0.79–0.83. Validated in chronic LBP, fibromyalgia, CRPS, post-surgical knee/shoulder, whiplash. Screens for yellow flag avoidance behavior. Short 11-item version preferred in clinical settings. Two subscales: Somatic Focus (SF) and Activity Avoidance (AA). No reverse scoring — all items sum directly.",
  "bodyRegions": ["Whole Body", "chronic pain", "lumbar spine", "back", "knee", "shoulder", "neck", "fear of movement", "kinesiophobia", "psychosocial"],
  "totalItems": 11,
  "responseScale": {
    "type": "ordinal",
    "anchor1": "Strongly Disagree",
    "anchor4": "Strongly Agree",
    "pointsPerItem": 4,
    "minRawPerItem": 1,
    "maxRawPerItem": 4,
    "reverseScored": false
  },
  "scoring": {
    "method": "sum",
    "formula": "sum of all 11 item scores (no reverse scoring)",
    "unit": "points",
    "minScore": 11,
    "maxScore": 44,
    "range": "11–44 (higher = greater kinesiophobia)",
    "subscales": [
      {
        "name": "Somatic Focus",
        "abbreviation": "SF",
        "items": [1, 2, 3, 5, 6, 7, 9],
        "minScore": 7,
        "maxScore": 28
      },
      {
        "name": "Activity Avoidance",
        "abbreviation": "AA",
        "items": [4, 8, 10, 11],
        "minScore": 4,
        "maxScore": 16
      }
    ],
    "interpretationBands": [
      { "label": "Low kinesiophobia",      "min": 11, "max": 29 },
      { "label": "Moderate kinesiophobia", "min": 30, "max": 36 },
      { "label": "High kinesiophobia",     "min": 37, "max": 44 }
    ],
    "mcid": 5,
    "mcidNote": "~5-point change considered clinically meaningful",
    "icc": "0.80–0.87",
    "mdc": "~5 pts"
  },
