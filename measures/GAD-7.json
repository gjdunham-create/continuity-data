  "icfLabel": "Emotional Functions",
  "type": "Screening",
  "description": "7-item self-report tool for screening and measuring the severity of generalized anxiety disorder.",
  "instructions": "Over the last 2 weeks, how often have you been bothered by the following problems?",
  "copyright": "Public Domain (Pfizer release, no fee, no permission required)",
  "shirleySays": "Sensitivity 89%, Specificity 82% for GAD (cutoff ≥10). Also screens for panic disorder, social anxiety, PTSD (cutoff ≥8). Cronbach α 0.92. MDC: 4 points. MCID: 4 points. Validated in primary care, musculoskeletal, neurological, cardiac, and oncology populations.",
  "bodyRegions": ["Mental Health", "psychosocial", "anxiety", "whole body"],
  "totalItems": 7,
  "responseScale": {
    "type": "ordinal",
    "pointsPerItem": 3,
    "maxRawScore": 21
  },
  "scoring": {
    "method": "sum",
    "formula": "sum of all item scores",
    "minScore": 0,
    "maxScore": 21,
    "range": "0–21",
    "interpretationBands": [
      { "label": "Minimal anxiety",  "min": 0,  "max": 4  },
      { "label": "Mild anxiety",     "min": 5,  "max": 9  },
      { "label": "Moderate anxiety", "min": 10, "max": 14 },
      { "label": "Severe anxiety",   "min": 15, "max": 21 }
    ],
    "mcid": 4,
    "mcidNote": "4-point change is considered clinically meaningful",
    "icc": "not applicable (screening tool)",
    "mdc": "4 points"
  },
