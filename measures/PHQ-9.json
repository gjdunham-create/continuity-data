  "icfLabel": "Emotional Functions",
  "type": "Screening",
  "description": "9-item self-report tool for screening, diagnosing, monitoring, and measuring the severity of depression.",
  "instructions": "Over the last 2 weeks, how often have you been bothered by any of the following problems?",
  "copyright": "Public Domain (Pfizer release, no fee, no permission required)",
  "shirleySays": "Sensitivity 88%, Specificity 88% for major depression (cutoff ≥10). MDC: 5 points. MCID: 5 points. Cronbach α 0.89. Normed: primary care, chronic pain, stroke, cancer, cardiac rehab, veterans, older adults, adolescents. ≥10 warrants referral. Widely used in PT to screen for psychosocial yellow flags.",
  "bodyRegions": ["Mental Health", "psychosocial", "depression", "whole body"],
  "totalItems": 9,
  "responseScale": {
    "type": "ordinal",
    "pointsPerItem": 3,
    "maxRawScore": 27
  },
  "scoring": {
    "method": "sum",
    "formula": "sum of all item scores",
    "minScore": 0,
    "maxScore": 27,
    "range": "0–27",
    "interpretationBands": [
      { "label": "Minimal depression",         "min": 0,  "max": 4  },
      { "label": "Mild depression",            "min": 5,  "max": 9  },
      { "label": "Moderate depression",        "min": 10, "max": 14 },
      { "label": "Moderately severe depression","min": 15, "max": 19 },
      { "label": "Severe depression",          "min": 20, "max": 27 }
    ],
    "mcid": 5,
    "mcidNote": "5-point change is considered clinically meaningful",
    "icc": "not applicable (screening tool)",
    "mdc": "5 points"
  },
