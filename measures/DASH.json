      { "label": "Mild disability",     "min": 11, "max": 30  },
      { "label": "Moderate disability", "min": 31, "max": 60  },
      { "label": "Severe disability",   "min": 61, "max": 100 }
    ],
    "mcid": 10,
    "mcidNote": "10–15 pts MCID; healthy adult mean ≈10; MDC 10.8 pts",
    "icc": "0.92–0.96",
    "mdc": "10.8 pts"
  },
