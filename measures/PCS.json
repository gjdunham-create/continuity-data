  "icfLabel": "Pain Catastrophizing",
  "type": "Screening",
  "description": "13-item self-report scale measuring the degree to which people catastrophize about pain. Three subscales: Rumination, Magnification, and Helplessness. Higher scores indicate greater catastrophizing.",
  "instructions": "Everyone experiences painful situations at some point in their lives. Such experiences may include headaches, tooth pain, joint or muscle pain. People are often exposed to situations that may cause pain such as illness, injury, dental procedures, or surgery.\n\nWe are interested in the types of thoughts and feelings that you have when you are in pain. Listed below are thirteen statements describing different thoughts and feelings that may be associated with pain. Using the scale below, please indicate the degree to which you have these thoughts and feelings when you are experiencing pain.",
  "copyright": "Free for clinical/research use (Sullivan et al. 1995)",
  "shirleySays": "ICC 0.92. Cronbach α 0.87–0.92. MDC: ~9 pts. MCID: ~9 pts. Three subscales: Rumination (items 8–11), Magnification (items 6–7, 13), Helplessness (items 1–5, 12). Validated in chronic pain, LBP, fibromyalgia, CRPS, surgical pre-op, cancer, RA. Strong predictor of pain disability and treatment non-response. Score ≥30 = clinically significant; warrants psychosocial referral.",
  "bodyRegions": ["Whole Body", "chronic pain", "lumbar spine", "back", "shoulder", "knee", "psychosocial", "pain catastrophizing"],
  "totalItems": 13,
  "responseScale": {
    "type": "ordinal",
    "pointsPerItem": 4,
    "maxRawScore": 52
  },
  "scoring": {
    "method": "sum",
    "formula": "sum of all 13 item scores",
    "minScore": 0,
    "maxScore": 52,
    "range": "0–52 (13 items × 0–4; higher = more catastrophizing)",
    "subscales": ["Helplessness (items 1–5, 12)", "Magnification (items 6–7, 13)", "Rumination (items 8–11)"],
    "interpretationBands": [
      { "label": "No concern",             "min": 0,  "max": 9  },
      { "label": "Mild catastrophizing",   "min": 10, "max": 19 },
      { "label": "Moderate catastrophizing","min": 20, "max": 29 },
      { "label": "Clinically significant", "min": 30, "max": 52 }
    ],
    "mcid": 9,
